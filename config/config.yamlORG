Database: "SILVA:release_138.2"
#"Greengenes2:release214_2024.09" "GTDB:release214_214.0" "SILVA:release_138.1" 
GCN_ref: "https://rrndb.umms.med.umich.edu/static/download/rrnDB-5.8_pantaxa_stats_NCBI.tsv.zip"
Dataset: "path to dataset"
instance: "custom instance name"
technology: illumina #NGS illumina, nanopore, pacbio
uncompress: false #true the output are fastq.gz (true is mandatory for lotus) 
min_len: 100
forward_primer: "AGAGTTTGATCMTGGCTCAG" #27F
reverse_primer: "TACGGYTACCTTGTTACGACTT" #1492R
clara16s_master: quay.io/clara16s/clara16s_master:v1.0.0_cv1
docker_memory: 40g
no_evaluation: []
distribute_cores_to_n_tasks: 1
sample:
  - Sample1
  - Sample2
